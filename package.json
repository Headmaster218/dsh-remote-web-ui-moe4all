{
  "name": "dsh-remote-web-ui-moe4all",
  "description": "MoE4All edition of scan-to-pair remote access for the DSH web GUI",
  "version": "0.3.17-moe4all.1",
  "type": "module",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/client.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "assets",
    "cordis.patch.yml"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Headmaster218/dsh-remote-web-ui-moe4all.git"
  },
  "homepage": "https://github.com/Headmaster218/dsh-remote-web-ui-moe4all#readme",
  "bugs": {
    "url": "https://github.com/Headmaster218/dsh-remote-web-ui-moe4all/issues"
  },
  "moe4all": {
    "upstream": "@linxin666/dsh-remote-web-ui@0.3.17",
    "repository": "https://github.com/zhu1090093659/dsh-web",
    "commit": "46f1616f26525c7b8a782968f02fa97fde2c5790"
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.1.1-rc.2"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ],
      "external": [
        "@deepseek-ai/dsh-client-runtime/client"
      ],
      "platform": "web"
    }
  },
  "dependencies": {
    "cloudflared": "^0.7.3",
    "clsx": "^2.1.1",
    "qrcode.react": "^4.2.0",
    "schemastery": "^3.18.0",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-agent": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-api-remotes": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-api-session-controller": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-api-workspace-controller": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-client-connection": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-client-locale": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-client-runtime": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-store": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-client-ui-primitives": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-client-ui-renderer": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-client-ui-settings": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-client-ui-sidebar": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-commands": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-host-webserver": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-invariants": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-settings": "^0.1.2-rc.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.20.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.0",
    "jsdom": "29.1.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tsdown": "0.22.14",
    "@tsdown/css": "0.22.14",
    "typescript": "^6.0.3",
    "unrun": "^0.3.1",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.8"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && tsdown --config tsdown.config.ts && node scripts/embed-css.mjs",
    "test": "node --experimental-strip-types --test test/*.test.mjs",
    "typecheck": "tsc -b --pretty false",
    "ci:check": "node --experimental-vm-modules ci/plugin-ci.mjs check",
    "ci:test": "node ci/plugin-ci.mjs test",
    "ci:contract": "node ci/plugin-ci.mjs test-contract",
    "release:build": "node --experimental-vm-modules ci/plugin-ci.mjs pack",
    "release:verify": "node ci/plugin-ci.mjs verify-release"
  },
  "packageManager": "npm@10.9.2"
}
